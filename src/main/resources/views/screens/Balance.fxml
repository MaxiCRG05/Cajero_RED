<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aos.consumidoras.cajero_red.infrastructure.adapter.in.fx.BalanceController"
            stylesheets="@../styles.css"
            style="-fx-background-color: #f5f7fc;">

    <top>
        <fx:include source="../common/TopAppBar.fxml"/>
    </top>

    <left>
        <fx:include source="../common/SideNavBar.fxml" fx:id="sideNav"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 0;">
            <content>
                <VBox spacing="24" alignment="CENTER" style="-fx-padding: 32px 48px;">
                    <Text text="Saldo de su Cuenta" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #001c3e;"/>

                    <VBox styleClass="card" style="-fx-padding: 32px; -fx-min-width: 400;">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Text text="💰" style="-fx-font-size: 56px;"/>
                            <Text text="Saldo Disponible" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #001c3e;"/>
                        </HBox>
                        <Text fx:id="saldoText" text="" styleClass="balance-large" style="-fx-padding: 12px 0;"/>
                        <HBox spacing="24">
                            <VBox>
                                <Text text="Cuenta Corriente" style="-fx-font-size: 15px; -fx-fill: #5c6f87;"/>
                                <Text fx:id="numeroCuentaText" text="**** **** 0000" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                            </VBox>
                            <VBox>
                                <Text text="Titular" style="-fx-font-size: 15px; -fx-fill: #5c6f87;"/>
                                <Text fx:id="titularText" text="NOMBRE DEL TITULAR" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox styleClass="card" style="-fx-padding: 24px; -fx-min-width: 400;">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Text text="📋" style="-fx-font-size: 40px;"/>
                            <Text text="Transacciones Recientes" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #001c3e;"/>
                        </HBox>
                        <VBox fx:id="transactionsContainer" spacing="12" style="-fx-padding: 12px 0;"/>
                    </VBox>

                    <Button fx:id="backButton" text="Volver al Inicio" onAction="#goBackToMain" styleClass="secondary-btn" style="-fx-padding: 14px 48px; -fx-font-size: 18px;"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <fx:include source="../common/Footer.fxml"/>
    </bottom>
</BorderPane>
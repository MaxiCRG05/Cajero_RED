<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aos.consumidoras.cajero_red.infrastructure.adapter.in.fx.WithdrawNoCardMainController"
            stylesheets="@../styles.css"
            style="-fx-background-color: #f5f7fc;">

    <top>
        <fx:include source="../common/TopAppBar.fxml"/>
    </top>

    <center>
        <VBox spacing="20" alignment="CENTER" style="-fx-padding: 32px 48px; -fx-max-width: 700;">
            <Text text="Retiro sin Tarjeta" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #001c3e;"/>

            <!-- Saldo disponible -->
            <HBox spacing="12" alignment="CENTER" styleClass="card" style="-fx-padding: 12px 24px;">
                <Text text="💰" style="-fx-font-size: 40px;"/>
                <Text text="Saldo disponible: " style="-fx-font-size: 18px; -fx-fill: #5c6f87;"/>
                <Text fx:id="saldoLabel" text="" style="-fx-font-weight: bold; -fx-fill: #001c3e; -fx-font-size: 20px;"/>
            </HBox>

            <!-- Campo de monto -->
            <VBox spacing="6" alignment="CENTER">
                <Text text="Monto a Retirar" style="-fx-font-size: 16px; -fx-fill: #5c6f87;"/>
                <TextField fx:id="amountField"
                           style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #001c3e; -fx-pref-width: 320px; -fx-padding: 16px; -fx-alignment: CENTER_RIGHT;"
                           editable="false"/>
            </VBox>

            <!-- Montos rápidos -->
            <HBox fx:id="quickAmountsBox" spacing="12" alignment="CENTER">
                <Button text="\$100" onAction="#setAmount100" styleClass="quick-amount-btn" style="-fx-font-size: 16px; -fx-padding: 10px 24px;"/>
                <Button text="\$200" onAction="#setAmount200" styleClass="quick-amount-btn" style="-fx-font-size: 16px; -fx-padding: 10px 24px;"/>
                <Button text="\$500" onAction="#setAmount500" styleClass="quick-amount-btn" style="-fx-font-size: 16px; -fx-padding: 10px 24px; -fx-background-color: #001c3e; -fx-text-fill: white;"/>
                <Button text="\$1000" onAction="#setAmount1000" styleClass="quick-amount-btn" style="-fx-font-size: 16px; -fx-padding: 10px 24px;"/>
            </HBox>

            <!-- Teclado numérico -->
            <GridPane fx:id="keypadGrid" hgap="12" vgap="12" alignment="CENTER">
                <Button text="1" onAction="#pressKey1" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="numpad-btn"/>
                <Button text="2" onAction="#pressKey2" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="numpad-btn"/>
                <Button text="3" onAction="#pressKey3" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="numpad-btn"/>

                <Button text="4" onAction="#pressKey4" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="numpad-btn"/>
                <Button text="5" onAction="#pressKey5" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="numpad-btn"/>
                <Button text="6" onAction="#pressKey6" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="numpad-btn"/>

                <Button text="7" onAction="#pressKey7" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="numpad-btn"/>
                <Button text="8" onAction="#pressKey8" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="numpad-btn"/>
                <Button text="9" onAction="#pressKey9" GridPane.columnIndex="2" GridPane.rowIndex="2" styleClass="numpad-btn"/>

                <Button text="0" onAction="#pressKey0" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="numpad-btn"/>
                <Button text="." onAction="#pressDot" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="numpad-btn" style="-fx-font-weight: bold;"/>
                <Button text="⌫" onAction="#pressBackspace" GridPane.columnIndex="2" GridPane.rowIndex="3" styleClass="numpad-btn" style="-fx-background-color: #ffdad6;"/>
                <Button text="C" onAction="#clearAll" GridPane.columnIndex="3" GridPane.rowIndex="3" styleClass="numpad-btn" style="-fx-background-color: #e0e4ed;"/>
            </GridPane>

            <!-- Botones de acción -->
            <HBox spacing="20" alignment="CENTER">
                <Button fx:id="cancelButton" text="Cancelar" onAction="#handleCancel" styleClass="secondary-btn" style="-fx-font-size: 18px; -fx-padding: 14px 48px;"/>
                <Button fx:id="confirmButton" text="Confirmar" onAction="#handleConfirm" styleClass="primary-btn" style="-fx-font-size: 18px; -fx-padding: 14px 48px;"/>
            </HBox>
        </VBox>
    </center>

    <!-- Pie de página con botones de cerrar sesión y emergencia -->
    <bottom>
        <VBox spacing="8" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 1px 0 0 0; -fx-padding: 12px 24px; -fx-alignment: CENTER;">
            <HBox spacing="20" alignment="CENTER">
                <Button fx:id="logoutButton" text="Cerrar Sesión" onAction="#handleLogout"
                        style="-fx-background-color: transparent; -fx-text-fill: #ba1a1a; -fx-border-color: #ba1a1a; -fx-border-radius: 12px; -fx-padding: 10px 24px; -fx-font-size: 14px; -fx-font-weight: 600; -fx-cursor: hand;"/>
                <Button fx:id="emergencyButton" text="Asistencia de Emergencia" onAction="#handleEmergency"
                        style="-fx-background-color: #ba1a1a; -fx-text-fill: white; -fx-background-radius: 24px; -fx-padding: 10px 24px; -fx-font-size: 14px; -fx-font-weight: 700; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(239,68,68,0.3), 10, 0, 0, 4);"/>
            </HBox>
            <Text text="© 2026. Cajero RED." style="-fx-fill: #64748b; -fx-font-size: 12px;"/>
        </VBox>
    </bottom>
</BorderPane>
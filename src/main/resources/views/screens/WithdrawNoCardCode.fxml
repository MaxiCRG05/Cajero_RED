<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aos.consumidoras.cajero_red.infrastructure.adapter.in.fx.WithdrawNoCardCodeController"
            stylesheets="@../styles.css"
            style="-fx-background-color: #f5f7fc;">

    <top>
        <fx:include source="../common/TopAppBar.fxml"/>
    </top>

    <center>
        <VBox spacing="28" alignment="CENTER" style="-fx-padding: 60px; -fx-max-width: 600;">
            <Text text="Verificar Código" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-fill: #001c3e;"/>
            <Text text="Ingrese el código de 8 dígitos para retirar sin tarjeta" style="-fx-font-size: 20px; -fx-fill: #5c6f87;"/>

            <HBox spacing="10" alignment="CENTER">
                <Text fx:id="codigoDisplay" text="• • • • • • • •" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: #001c3e; -fx-letter-spacing: 8px;"/>
            </HBox>

            <GridPane hgap="12" vgap="12" alignment="CENTER">
                <Button text="1" onAction="#pressKey1" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="numpad-btn"/>
                <Button text="2" onAction="#pressKey2" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="numpad-btn"/>
                <Button text="3" onAction="#pressKey3" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="numpad-btn"/>

                <Button text="4" onAction="#pressKey4" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="numpad-btn"/>
                <Button text="5" onAction="#pressKey5" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="numpad-btn"/>
                <Button text="6" onAction="#pressKey6" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="numpad-btn"/>

                <Button text="7" onAction="#pressKey7" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="numpad-btn"/>
                <Button text="8" onAction="#pressKey8" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="numpad-btn"/>
                <Button text="9" onAction="#pressKey9" GridPane.columnIndex="2" GridPane.rowIndex="2" styleClass="numpad-btn"/>

                <Button text="0" onAction="#pressKey0" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="numpad-btn"/>
                <Button text="⌫" onAction="#pressBackspace" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="numpad-btn" style="-fx-background-color: #ffdad6;"/>
                <Button text="C" onAction="#clearAll" GridPane.columnIndex="2" GridPane.rowIndex="3" styleClass="numpad-btn" style="-fx-background-color: #e0e4ed;"/>
            </GridPane>

            <TextField fx:id="hiddenCodeField" promptText=""
                       style="-fx-opacity: 0; -fx-pref-width: 0; -fx-pref-height: 0; -fx-padding: 0; -fx-border-width: 0;"
                       editable="true" focusTraversable="true"/>

            <Label fx:id="mensajeLabel" textFill="red" wrapText="true" style="-fx-font-size: 16px; -fx-padding: 4px 0;"/>

            <HBox spacing="24" alignment="CENTER" style="-fx-padding: 10px 0;">
                <Button fx:id="btnCancelar" text="Cancelar" onAction="#handleCancel" styleClass="secondary-btn"
                        style="-fx-font-size: 20px; -fx-padding: 16px 56px;"/>
                <Button fx:id="btnVerificar" text="Verificar" onAction="#handleVerificar" styleClass="primary-btn"
                        style="-fx-font-size: 20px; -fx-padding: 16px 56px;"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <fx:include source="../common/Footer.fxml"/>
    </bottom>
</BorderPane>
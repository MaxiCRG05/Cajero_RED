<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aos.consumidoras.cajero_red.infrastructure.adapter.in.fx.TransferController"
            style="-fx-background-color: #f8f9ff;">

    <top>
        <fx:include source="../common/TopAppBar.fxml"/>
    </top>

    <left>
        <fx:include source="../common/SideNavBar.fxml"/>
    </left>

    <center>
        <VBox spacing="20" alignment="CENTER" style="-fx-padding: 20 40; -fx-max-width: 600;">
            <Text text="Transferencia SPEI" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-fill: #001c3e;"/>

            <VBox spacing="5" alignment="CENTER_LEFT" style="-fx-pref-width: 100%;">
                <Text text="CLABE destino" style="-fx-fill: #5c5f61;"/>
                <TextField fx:id="clabeField" promptText="876543210987654321" style="-fx-background-color: white; -fx-border-color: #c3c6d0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12; -fx-pref-width: 100%;"/>
            </VBox>

            <VBox spacing="5" alignment="CENTER_LEFT" style="-fx-pref-width: 100%;">
                <Text text="Nombre del Beneficiario" style="-fx-fill: #5c5f61;"/>
                <TextField fx:id="beneficiarioField" promptText="Nombre completo" style="-fx-background-color: white; -fx-border-color: #c3c6d0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12; -fx-pref-width: 100%;"/>
            </VBox>

            <VBox spacing="5" alignment="CENTER_LEFT" style="-fx-pref-width: 100%;">
                <Text text="Monto (MXN)" style="-fx-fill: #5c5f61;"/>
                <TextField fx:id="amountField" promptText="0.00" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #001c3e; -fx-background-color: white; -fx-border-color: #c3c6d0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12;"/>
            </VBox>

            <VBox spacing="5" alignment="CENTER_LEFT" style="-fx-pref-width: 100%;">
                <Text text="Concepto" style="-fx-fill: #5c5f61;"/>
                <TextField fx:id="conceptoField" promptText="Motivo del envío" style="-fx-background-color: white; -fx-border-color: #c3c6d0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12; -fx-pref-width: 100%;"/>
            </VBox>

            <HBox spacing="20" style="-fx-padding: 10 0;">
                <Button fx:id="cancelButton" text="Cancelar" onAction="#handleCancel" style="-fx-background-color: transparent; -fx-text-fill: #5c5f61; -fx-border-color: #c3c6d0; -fx-border-radius: 30; -fx-background-radius: 30; -fx-padding: 12 40;"/>
                <Button fx:id="confirmButton" text="Confirmar Transferencia" onAction="#handleConfirm" style="-fx-background-color: #001c3e; -fx-text-fill: white; -fx-border-radius: 30; -fx-background-radius: 30; -fx-padding: 12 40; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <fx:include source="../common/Footer.fxml"/>
    </bottom>
</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aos.consumidoras.cajero_red.infrastructure.adapter.in.fx.WithdrawController"
            style="-fx-background-color: #f8f9ff;">

    <top>
        <fx:include source="../common/TopAppBar.fxml"/>
    </top>

    <left>
        <fx:include source="../common/SideNavBar.fxml" fx:id="sideNav"/>
    </left>

    <center>
        <VBox spacing="20" alignment="CENTER" style="-fx-padding: 20 40; -fx-max-width: 600;">
            <Text text="Retiro de Efectivo" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-fill: #001c3e;"/>

            <HBox spacing="10" alignment="CENTER" style="-fx-background-color: #e6eeff; -fx-padding: 8 16; -fx-background-radius: 30;">
                <Text text="💰" style="-fx-font-size: 20;"/>
                <Text text="Saldo disponible: " style="-fx-fill: #5c5f61;"/>
                <Text fx:id="saldoLabel" text="\$2,450.00" style="-fx-font-weight: bold; -fx-fill: #001c3e;"/>
            </HBox>

            <VBox spacing="5" alignment="CENTER">
                <Text text="Monto a Retirar" style="-fx-fill: #5c5f61;"/>
                <TextField fx:id="amountField" style="-fx-font-size: 40; -fx-font-weight: bold; -fx-text-fill: #001c3e; -fx-background-color: white; -fx-border-color: #c3c6d0; -fx-border-radius: 16; -fx-background-radius: 16; -fx-padding: 16; -fx-pref-width: 300;" editable="false"/>
            </VBox>

            <HBox spacing="10">
                <Button text="\$100" onAction="#setAmount100" style="-fx-background-color: white; -fx-border-color: #c3c6d0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12 24;"/>
                <Button text="\$200" onAction="#setAmount200" style="-fx-background-color: white; -fx-border-color: #c3c6d0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12 24;"/>
                <Button text="\$500" onAction="#setAmount500" style="-fx-background-color: #0b315e; -fx-text-fill: white; -fx-border-color: #0b315e; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12 24;"/>
                <Button text="\$1000" onAction="#setAmount1000" style="-fx-background-color: white; -fx-border-color: #c3c6d0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12 24;"/>
            </HBox>

            <GridPane hgap="10" vgap="10" alignment="CENTER">
                <Button text="1" onAction="#pressKey1" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-pref-width: 60; -fx-pref-height: 60; -fx-font-size: 24; -fx-background-color: white; -fx-border-color: #c3c6d0; -fx-border-radius: 12; -fx-background-radius: 12;"/>
                <Button text="2" onAction="#pressKey2" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-pref-width: 60; -fx-pref-height: 60; -fx-font-size: 24; -fx-background-color: white; -fx-border-color: #c3c6d0; -fx-border-radius: 12; -fx-background-radius: 12;"/>
                <Button text="3" onAction="#pressKey3" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-pref-width: 60; -fx-pref-height: 60; -fx-font-size: 24; -fx-background-color: white; -fx-border-color: #c3c6d0; -fx-border-radius: 12; -fx-background-radius: 12;"/>
                <Button text="4" onAction="#pressKey4" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-pref-width: 60; -fx-pref-height: 60; -fx-font-size: 24; -fx-background-color: white; -fx-border-color: #c3c6d0; -fx-border-radius: 12; -fx-background-radius: 12;"/>
                <Button text="5" onAction="#pressKey5" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-pref-width: 60; -fx-pref-height: 60; -fx-font-size: 24; -fx-background-color: white; -fx-border-color: #c3c6d0; -fx-border-radius: 12; -fx-background-radius: 12;"/>
                <Button text="6" onAction="#pressKey6" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-pref-width: 60; -fx-pref-height: 60; -fx-font-size: 24; -fx-background-color: white; -fx-border-color: #c3c6d0; -fx-border-radius: 12; -fx-background-radius: 12;"/>
                <Button text="7" onAction="#pressKey7" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-pref-width: 60; -fx-pref-height: 60; -fx-font-size: 24; -fx-background-color: white; -fx-border-color: #c3c6d0; -fx-border-radius: 12; -fx-background-radius: 12;"/>
                <Button text="8" onAction="#pressKey8" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-pref-width: 60; -fx-pref-height: 60; -fx-font-size: 24; -fx-background-color: white; -fx-border-color: #c3c6d0; -fx-border-radius: 12; -fx-background-radius: 12;"/>
                <Button text="9" onAction="#pressKey9" GridPane.columnIndex="2" GridPane.rowIndex="2" style="-fx-pref-width: 60; -fx-pref-height: 60; -fx-font-size: 24; -fx-background-color: white; -fx-border-color: #c3c6d0; -fx-border-radius: 12; -fx-background-radius: 12;"/>
                <Button text="⌫" onAction="#pressBackspace" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-pref-width: 60; -fx-pref-height: 60; -fx-font-size: 24; -fx-background-color: #ffdad6; -fx-border-color: #c3c6d0; -fx-border-radius: 12; -fx-background-radius: 12;"/>
                <Button text="0" onAction="#pressKey0" GridPane.columnIndex="1" GridPane.rowIndex="3" style="-fx-pref-width: 60; -fx-pref-height: 60; -fx-font-size: 24; -fx-background-color: white; -fx-border-color: #c3c6d0; -fx-border-radius: 12; -fx-background-radius: 12;"/>
                <Button text="C" onAction="#clearAll" GridPane.columnIndex="2" GridPane.rowIndex="3" style="-fx-pref-width: 60; -fx-pref-height: 60; -fx-font-size: 24; -fx-background-color: #c3c6d0; -fx-border-color: #c3c6d0; -fx-border-radius: 12; -fx-background-radius: 12;"/>
            </GridPane>

            <HBox spacing="20" style="-fx-padding: 10 0;">
                <Button fx:id="cancelButton" text="Cancelar" onAction="#handleCancel" style="-fx-background-color: transparent; -fx-text-fill: #5c5f61; -fx-border-color: #c3c6d0; -fx-border-radius: 30; -fx-background-radius: 30; -fx-padding: 12 40;"/>
                <Button fx:id="confirmButton" text="Confirmar" onAction="#handleConfirm" style="-fx-background-color: #001c3e; -fx-text-fill: white; -fx-border-radius: 30; -fx-background-radius: 30; -fx-padding: 12 40; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <fx:include source="../common/Footer.fxml"/>
    </bottom>
</BorderPane>
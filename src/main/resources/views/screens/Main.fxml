<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aos.consumidoras.cajero_red.infrastructure.adapter.in.fx.MainController"
            stylesheets="@../styles.css"
            style="-fx-background-color: #f5f7fc;">

    <top>
        <fx:include source="../common/TopAppBar.fxml"/>
    </top>

    <left>
        <fx:include source="../common/SideNavBar.fxml" fx:id="sideNav"/>
    </left>

    <center>
        <VBox spacing="28" style="-fx-padding: 32px 48px;">
            <!-- Saludo -->
            <VBox spacing="6">
                <Text text="Estado de sesión: Protegido" style="-fx-font-size: 14px; -fx-fill: #5c6f87;"/>
                <Text fx:id="welcomeMessage" text="Buenos Días, Juan Pérez"
                      style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-fill: #001c3e;"/>
                <Region style="-fx-background-color: #4edea3; -fx-pref-height: 6px; -fx-pref-width: 80px; -fx-background-radius: 4px;"/>
            </VBox>

            <!-- Grid de tarjetas -->
            <GridPane hgap="24" vgap="24" VBox.vgrow="ALWAYS">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <!-- Retirar -->
                <Button fx:id="withdrawCard" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2"
                        styleClass="card" style="-fx-alignment: center-left; -fx-padding: 24px 28px; -fx-cursor: hand;"
                        onAction="#goToWithdraw">
                    <graphic>
                        <HBox spacing="20" alignment="CENTER_LEFT">
                            <Text text="🏧" style="-fx-font-size: 56px;"/>
                            <VBox spacing="6" alignment="CENTER_LEFT">
                                <Text text="Retirar Dinero" styleClass="card-title"/>
                                <Text text="Acceso rápido a efectivo" styleClass="card-subtitle"/>
                                <HBox spacing="10">
                                    <Text text="\$100" style="-fx-font-size: 14px; -fx-fill: #001c3e; -fx-background-color: #e6eeff; -fx-padding: 4px 14px; -fx-background-radius: 14px;"/>
                                    <Text text="\$200" style="-fx-font-size: 14px; -fx-fill: #001c3e; -fx-background-color: #e6eeff; -fx-padding: 4px 14px; -fx-background-radius: 14px;"/>
                                    <Text text="\$500" style="-fx-font-size: 14px; -fx-fill: #001c3e; -fx-background-color: #e6eeff; -fx-padding: 4px 14px; -fx-background-radius: 14px;"/>
                                </HBox>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Text text="→" style="-fx-font-size: 24px; -fx-fill: #001c3e; -fx-font-weight: bold;"/>
                        </HBox>
                    </graphic>
                </Button>

                <!-- Consultar Saldo -->
                <Button fx:id="balanceCard" GridPane.columnIndex="0" GridPane.rowIndex="1"
                        styleClass="card" style="-fx-background-color: #001c3e; -fx-alignment: center-left; -fx-padding: 24px 28px; -fx-cursor: hand;"
                        onAction="#goToBalance">
                    <graphic>
                        <HBox spacing="20" alignment="CENTER_LEFT">
                            <Text text="💰" style="-fx-font-size: 56px;"/>
                            <VBox spacing="6" alignment="CENTER_LEFT">
                                <Text text="Consultar Saldo" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: white;"/>
                                <Text text="Revise sus balances" style="-fx-font-size: 16px; -fx-fill: rgba(255,255,255,0.7);"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Text text="→" style="-fx-font-size: 24px; -fx-fill: rgba(255,255,255,0.5); -fx-font-weight: bold;"/>
                        </HBox>
                    </graphic>
                </Button>

                <!-- Depositar -->
                <Button fx:id="depositCard" GridPane.columnIndex="1" GridPane.rowIndex="1"
                        styleClass="card" style="-fx-background-color: #0b315e; -fx-alignment: center-left; -fx-padding: 24px 28px; -fx-cursor: hand;"
                        onAction="#goToDeposit">
                    <graphic>
                        <HBox spacing="20" alignment="CENTER_LEFT">
                            <Text text="💵" style="-fx-font-size: 56px;"/>
                            <VBox spacing="6" alignment="CENTER_LEFT">
                                <Text text="Depositar" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: white;"/>
                                <Text text="Depósito de efectivo" style="-fx-font-size: 16px; -fx-fill: rgba(255,255,255,0.7);"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Text text="→" style="-fx-font-size: 24px; -fx-fill: rgba(255,255,255,0.5); -fx-font-weight: bold;"/>
                        </HBox>
                    </graphic>
                </Button>

                <!-- Transferir -->
                <Button fx:id="transferCard" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2"
                        styleClass="card" style="-fx-alignment: center-left; -fx-padding: 24px 28px; -fx-cursor: hand;"
                        onAction="#goToTransfer">
                    <graphic>
                        <HBox spacing="20" alignment="CENTER_LEFT">
                            <Text text="🔄" style="-fx-font-size: 56px;"/>
                            <VBox spacing="6" alignment="CENTER_LEFT">
                                <Text text="Transferir Fondos" styleClass="card-title"/>
                                <Text text="Envíe dinero a otras cuentas o pague sus tarjetas." styleClass="card-subtitle"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Text text="Comenzar →" style="-fx-font-size: 16px; -fx-fill: #001c3e; -fx-font-weight: bold; -fx-background-color: #e6eeff; -fx-padding: 6px 16px; -fx-background-radius: 24px;"/>
                        </HBox>
                    </graphic>
                </Button>
            </GridPane>
        </VBox>
    </center>

    <bottom>
        <fx:include source="../common/Footer.fxml"/>
    </bottom>
</BorderPane>
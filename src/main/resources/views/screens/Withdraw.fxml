<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aos.consumidoras.cajero_red.infrastructure.adapter.in.fx.WithdrawController"
            stylesheets="@../styles.css"
            style="-fx-background-color: #f5f7fc;">

    <top>
        <fx:include source="../common/TopAppBar.fxml"/>
    </top>

    <left>
        <fx:include source="../common/SideNavBar.fxml" fx:id="sideNav"/>
    </left>

    <center>
        <VBox spacing="20" alignment="CENTER" style="-fx-padding: 32px 48px; -fx-max-width: 700;">
            <Text text="Retiro de Efectivo" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #001c3e;"/>

            <!-- Saldo disponible -->
            <HBox spacing="12" alignment="CENTER" styleClass="card" style="-fx-padding: 12px 24px;">
                <Text text="💰" style="-fx-font-size: 40px;"/>
                <Text text="Saldo disponible: " style="-fx-font-size: 18px; -fx-fill: #5c6f87;"/>
                <Text fx:id="saldoLabel" text="" style="-fx-font-weight: bold; -fx-fill: #001c3e; -fx-font-size: 20px;"/>
            </HBox>

            <!-- Campo de monto con "$" fijo y alineación a la derecha -->
            <VBox spacing="6" alignment="CENTER">
                <Text text="Monto a Retirar" style="-fx-font-size: 16px; -fx-fill: #5c6f87;"/>
                <TextField fx:id="amountField"
                           style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #001c3e; -fx-pref-width: 320px; -fx-padding: 16px; -fx-alignment: CENTER_RIGHT;"
                           editable="false"/>
            </VBox>

            <!-- Montos rápidos (escapados) -->
            <HBox fx:id="quickAmountsBox" spacing="12" alignment="CENTER">
                <Button text="\$100" onAction="#setAmount100" styleClass="quick-amount-btn"/>
                <Button text="\$200" onAction="#setAmount200" styleClass="quick-amount-btn"/>
                <Button text="\$500" onAction="#setAmount500" styleClass="quick-amount-btn"/>
                <Button text="\$1000" onAction="#setAmount1000" styleClass="quick-amount-btn"/>
            </HBox>

            <GridPane fx:id="keypadGrid" hgap="12" vgap="12" alignment="CENTER">
                <Button text="1" onAction="#pressKey1" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="numpad-btn"/>
                <Button text="2" onAction="#pressKey2" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="numpad-btn"/>
                <Button text="3" onAction="#pressKey3" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="numpad-btn"/>

                <Button text="4" onAction="#pressKey4" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="numpad-btn"/>
                <Button text="5" onAction="#pressKey5" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="numpad-btn"/>
                <Button text="6" onAction="#pressKey6" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="numpad-btn"/>

                <Button text="7" onAction="#pressKey7" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="numpad-btn"/>
                <Button text="8" onAction="#pressKey8" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="numpad-btn"/>
                <Button text="9" onAction="#pressKey9" GridPane.columnIndex="2" GridPane.rowIndex="2" styleClass="numpad-btn"/>

                <!-- Fila 3: 0, punto, backspace y clear -->
                <Button text="0" onAction="#pressKey0" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="numpad-btn"/>
                <Button text="⌫" onAction="#pressBackspace" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="numpad-btn" style="-fx-background-color: #ffdad6; font-size: 12px"/>
                <Button text="C" onAction="#clearAll" GridPane.columnIndex="2" GridPane.rowIndex="3" styleClass="numpad-btn" style="-fx-background-color: #e0e4ed;"/>
            </GridPane>

            <!-- Botones de acción centrados -->
            <HBox spacing="20" alignment="CENTER">
                <Button fx:id="cancelButton" text="Cancelar" onAction="#handleCancel" styleClass="secondary-btn" style="-fx-font-size: 18px; -fx-padding: 14px 48px;"/>
                <Button fx:id="confirmButton" text="Confirmar" onAction="#handleConfirm" styleClass="primary-btn" style="-fx-font-size: 18px; -fx-padding: 14px 48px;"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <fx:include source="../common/Footer.fxml"/>
    </bottom>
</BorderPane>
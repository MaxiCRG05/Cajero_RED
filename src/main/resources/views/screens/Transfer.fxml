<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aos.consumidoras.cajero_red.infrastructure.adapter.in.fx.TransferController"
            stylesheets="@../styles.css"
            style="-fx-background-color: #f5f7fc;">

    <top>
        <fx:include source="../common/TopAppBar.fxml"/>
    </top>

    <left>
        <fx:include source="../common/SideNavBar.fxml" fx:id="sideNav"/>
    </left>

    <center>
        <VBox spacing="20" alignment="CENTER" style="-fx-padding: 32px 48px; -fx-max-width: 600;">
            <Text text="Transferencia SPEI" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #001c3e;"/>

            <!-- Campos del formulario -->
            <VBox spacing="6" alignment="CENTER_LEFT" style="-fx-pref-width: 100%;">
                <Text text="CLABE destino" style="-fx-font-size: 16px; -fx-fill: #5c6f87;"/>
                <TextField fx:id="clabeField" promptText="876543210987654321" style="-fx-pref-width: 100%; -fx-font-size: 18px; -fx-padding: 16px;"/>
            </VBox>

            <VBox spacing="6" alignment="CENTER_LEFT" style="-fx-pref-width: 100%;">
                <Text text="Nombre del Beneficiario" style="-fx-font-size: 16px; -fx-fill: #5c6f87;"/>
                <TextField fx:id="beneficiarioField" promptText="Nombre completo" style="-fx-pref-width: 100%; -fx-font-size: 18px; -fx-padding: 16px;"/>
            </VBox>

            <VBox spacing="6" alignment="CENTER_LEFT" style="-fx-pref-width: 100%;">
                <Text text="Monto (MXN)" style="-fx-font-size: 16px; -fx-fill: #5c6f87;"/>
                <TextField fx:id="amountField" promptText="0.00"
                           style="-fx-pref-width: 100%; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #001c3e; -fx-padding: 16px; -fx-alignment: CENTER_RIGHT;"/>
            </VBox>

            <VBox spacing="6" alignment="CENTER_LEFT" style="-fx-pref-width: 100%;">
                <Text text="Concepto" style="-fx-font-size: 16px; -fx-fill: #5c6f87;"/>
                <TextField fx:id="conceptoField" promptText="Motivo del envío" style="-fx-pref-width: 100%; -fx-font-size: 18px; -fx-padding: 16px;"/>
            </VBox>

            <!-- Botones de acción centrados -->
            <HBox spacing="20" alignment="CENTER" style="-fx-padding: 16px 0;">
                <Button fx:id="cancelButton" text="Cancelar" onAction="#handleCancel" styleClass="secondary-btn" style="-fx-font-size: 18px; -fx-padding: 14px 48px;"/>
                <Button fx:id="confirmButton" text="Confirmar Transferencia" onAction="#handleConfirm" styleClass="primary-btn" style="-fx-font-size: 18px; -fx-padding: 14px 48px;"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <fx:include source="../common/Footer.fxml"/>
    </bottom>
</BorderPane>
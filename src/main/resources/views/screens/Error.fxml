<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aos.consumidoras.cajero_red.infrastructure.adapter.in.fx.ErrorController"
            style="-fx-background-color: #f8f9ff;">

    <top>
        <fx:include source="../common/TopAppBar.fxml"/>
    </top>

    <left>
        <fx:include source="../common/SideNavBar.fxml" fx:id="sideNav"/>
    </left>

    <center>
        <VBox spacing="20" alignment="CENTER" style="-fx-padding: 40;">
            <Text text="⚠️" style="-fx-font-size: 80;"/>
            <Text fx:id="errorMessage" text="Ha ocurrido un error inesperado" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-fill: #ba1a1a;"/>
            <HBox spacing="20" style="-fx-padding: 10 0;">
                <Button fx:id="retryButton" text="Reintentar" onAction="#handleRetry" style="-fx-background-color: #001c3e; -fx-text-fill: white; -fx-border-radius: 30; -fx-background-radius: 30; -fx-padding: 12 40;"/>
                <Button fx:id="cancelButton" text="Cancelar" onAction="#handleCancel" style="-fx-background-color: transparent; -fx-text-fill: #5c5f61; -fx-border-color: #c3c6d0; -fx-border-radius: 30; -fx-background-radius: 30; -fx-padding: 12 40;"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <fx:include source="../common/Footer.fxml"/>
    </bottom>
</BorderPane>
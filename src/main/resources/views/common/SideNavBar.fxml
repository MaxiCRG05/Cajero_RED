<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.aos.consumidoras.cajero_red.infrastructure.adapter.in.fx.SideNavBarController"
      styleClass="side-nav"
      style="-fx-pref-width: 300; -fx-padding: 28px 20px; -fx-spacing: 14px; -fx-background-color: white; -fx-border-color: #c3c6d0; -fx-border-radius: 24; -fx-background-radius: 24;">

    <VBox spacing="8" alignment="CENTER_LEFT">
        <Text text="👤" style="-fx-font-size: 60;"/>
        <Text text="Bienvenido de nuevo" style="-fx-font-size: 18; -fx-fill: #5c5f61;"/>
        <Text fx:id="userNameLabel" text="Juan Pérez" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-fill: #001c3e;"/>
    </VBox>

    <Separator/>

    <!-- Botones con contentDisplay="LEFT" para que el indicador (graphic) se muestre a la izquierda -->
    <Button fx:id="homeButton" text="Inicio" contentDisplay="LEFT" onAction="#handleHome" maxWidth="Infinity" style="-fx-font-size: 18px; -fx-padding: 12px 16px; -fx-alignment: CENTER_LEFT;"/>
    <Button fx:id="withdrawButton" text="Retirar" contentDisplay="LEFT" onAction="#handleWithdraw" maxWidth="Infinity" style="-fx-font-size: 18px; -fx-padding: 12px 16px; -fx-alignment: CENTER_LEFT;"/>
    <Button fx:id="depositButton" text="Depositar" contentDisplay="LEFT" onAction="#handleDeposit" maxWidth="Infinity" style="-fx-font-size: 18px; -fx-padding: 12px 16px; -fx-alignment: CENTER_LEFT;"/>
    <Button fx:id="balanceButton" text="Consultar Saldo" contentDisplay="LEFT" onAction="#handleBalance" maxWidth="Infinity" style="-fx-font-size: 18px; -fx-padding: 12px 16px; -fx-alignment: CENTER_LEFT;"/>
    <Button fx:id="transferButton" text="Transferir" contentDisplay="LEFT" onAction="#handleTransfer" maxWidth="Infinity" style="-fx-font-size: 18px; -fx-padding: 12px 16px; -fx-alignment: CENTER_LEFT;"/>

    <Region VBox.vgrow="ALWAYS"/>

    <Button fx:id="logoutButton" text="Cerrar Sesión" onAction="#handleLogout"
            style="-fx-font-size: 16px; -fx-padding: 14px; -fx-background-color: transparent; -fx-text-fill: #ba1a1a; -fx-border-color: #ba1a1a; -fx-border-radius: 12px;" maxWidth="Infinity"/>
    <Button fx:id="emergencyButton" text="Asistencia de Emergencia" onAction="#handleEmergency"
            style="-fx-font-size: 16px; -fx-padding: 14px; -fx-background-color: #ba1a1a; -fx-text-fill: white; -fx-background-radius: 24px;" maxWidth="Infinity"/>
</VBox>
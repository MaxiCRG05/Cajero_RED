<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aos.consumidoras.cajero_red.infrastructure.adapter.in.fx.BalanceController"
            style="-fx-background-color: #f8f9ff;">

    <top>
        <fx:include source="../common/TopAppBar.fxml"/>
    </top>

    <left>
        <fx:include source="../common/SideNavBar.fxml" fx:id="sideNav"/>
    </left>

    <center>
        <VBox spacing="20" style="-fx-padding: 20 40; -fx-max-width: 800;">
            <Text text="Saldo de su Cuenta" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-fill: #001c3e;"/>

            <VBox style="-fx-background-color: white; -fx-border-color: #c3c6d0; -fx-border-radius: 24; -fx-background-radius: 24; -fx-padding: 24;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Text text="💰" style="-fx-font-size: 32;"/>
                    <Text text="Saldo Disponible" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-fill: #001c3e;"/>
                </HBox>
                <Text fx:id="saldoText" text="\$5,420.00 MXN" style="-fx-font-size: 48; -fx-font-weight: bold; -fx-fill: #001c3e; -fx-padding: 10 0;"/>
                <HBox spacing="20">
                    <VBox><Text text="Cuenta Corriente" style="-fx-fill: #5c5f61;"/><Text text="**** **** 8842" style="-fx-font-weight: bold;"/></VBox>
                    <VBox><Text text="Titular" style="-fx-fill: #5c5f61;"/><Text text="JUAN PÉREZ" style="-fx-font-weight: bold;"/></VBox>
                </HBox>
            </VBox>

            <VBox style="-fx-background-color: white; -fx-border-color: #c3c6d0; -fx-border-radius: 24; -fx-background-radius: 24; -fx-padding: 24;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Text text="📋" style="-fx-font-size: 24;"/>
                    <Text text="Transacciones Recientes" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-fill: #001c3e;"/>
                </HBox>
                <VBox fx:id="transactionsContainer" spacing="10" style="-fx-padding: 10 0;"/>
            </VBox>

            <Button fx:id="backButton" text="Volver al Inicio" onAction="#goBackToMain" style="-fx-background-color: #001c3e; -fx-text-fill: white; -fx-border-radius: 30; -fx-background-radius: 30; -fx-padding: 16 40; -fx-font-weight: bold;"/>
        </VBox>
    </center>

    <bottom>
        <fx:include source="../common/Footer.fxml"/>
    </bottom>
</BorderPane>